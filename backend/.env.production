# 线上部署（WorkBuddy 托管沙箱）专用环境变量。
# 与本地 .env 的区别：不包含任何真实 API Key —— 线上以 Mock 模式运行，
# 完整演示研究工作流，但 LLM 输出是模拟的、检索走离线语料。
#
# 运维提示：沙箱只给一个 HTTP 端口、没有 MySQL/Redis。
# 本项目全部用 SQLite（随项目自带），所以可以直接跑。

ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=plain

# ----- LLM：Mock 模式（无 Key）-----
# auto = 有 Key 走真实 API，没 Key 自动退化成离线 Mock
LLM_PROVIDER=auto
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ----- 联网搜索：离线语料 -----
# 不配 TAVILY_API_KEY，搜索走内置示例语料（stub 行为）
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SEARCH_DEPTH=basic

# ----- Embedding：本地哈希向量 -----
EMBEDDING_PROVIDER=auto
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# ----- CORS -----
# 单端口部署下前端与后端**同源**，浏览器根本不发跨域请求，
# 所以这里不需要放部署域名。留 * 是为了容错：将来若前端被单独托管
# （不同域名），不至于因为白名单没更新而全部请求被拦。
# 注意：allow_credentials=True 与 "*" 组合时，Starlette 会回显具体 Origin
# 而不是通配符，因此不带 cookie 的场景下这条配置能正常工作。
CORS_ORIGINS=*

# ----- 存储（SQLite，随项目自带）-----
KNOWLEDGE_DB_PATH=storage/knowledge.db
AGENT_RUNS_DB_PATH=storage/agent_runs.db
EVENTS_DB_PATH=storage/events.db
SEARCH_QUOTA_DB_PATH=storage/search_quota.db
STORAGE_DIR=storage/documents

# 单 worker：WAL 长连接在多进程写入下会永久退化为只读，且配额单例无重连路径
# （详见 app/search/quota.py 顶部 docstring）。启动命令里不要加 --workers。
